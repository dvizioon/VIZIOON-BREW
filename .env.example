# ========================================
# Configuração do Sistema
# ========================================
SYSTEM_NAME=vizioon-brew
SYSTEM_VERSION=1.0.0
SYSTEM_DESCRIPTION=Plataforma de estudos de Java
SYSTEM_FAVICON=./src/app/icon.svg
SYSTEM_LOGO=./src/app/icon.svg

# ========================================
# Ambiente — development | production | test
# ========================================
NODE_ENV=development

# ========================================
# Logs
# ========================================
LOG_LEVEL=debug
LOG_PRETTY=true

# ========================================
# Banco de Dados
DATABASE_URL=file:./dev.db
# DB_HOST=localhost
# DB_PORT=9867
# DB_NAME=vizioon-brew
# DB_USER=postgres
# DB_PREFIX=vizioon_
# DB_PASS=postgres
# DB_DIALECT=postgres
# DB_DEBUG=false

# ========================================
# Backend
# ========================================
AUTH_SECRET=troque-por-um-segredo-longo
AUTH_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
HOST=0.0.0.0

# ========================================
# JWT - openssl rand -base64 32
# ========================================
JWT_ACCESS_SECRET=troque-por-um-segredo-longo
JWT_REFRESH_SECRET=troque-por-um-segredo-longo
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================================
# Filas
# ========================================
# RABBITMQ_ENABLED=true
# RABBITMQ_PROTOCOL=amqp
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=9870
# RABBITMQ_USER=admin
# RABBITMQ_PASS=admin123
# RABBITMQ_VHOST=/
# RABBITMQ_PREFETCH=5
# # RABBITMQ_BATCH_CHUNK_SIZE=25
# # RABBITMQ_BATCH_CONCURRENCY=3

# # Valores de Batch para testes
# RABBITMQ_BATCH_CHUNK_SIZE=40
# RABBITMQ_BATCH_CONCURRENCY=40

# ========================================
# Redis
# ========================================
# REDIS_ENABLED=true
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=troque-a-senha

# ========================================
# S3
# ========================================
S3_ENABLED=false
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=...
# S3_PORT=9000
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_USE_SSL=false
# S3_PRESIGN_EXPIRES_IN=3600

# ========================================
# Local Storage
# ========================================
LOCAL_STORAGE_PATH=./storage

# ========================================
# Provas de código
# ========================================
# A prova usa os pacotes em src/modules/runtimes. Este caminho é opcional.
# PYTHON_BIN=/caminho/do/python3

# ========================================
# Seed
# ========================================
SEED_MASTER_EMAIL=admin@admin.com
SEED_MASTER_PASSWORD=admin123
SEED_MASTER_NAME=Admin
