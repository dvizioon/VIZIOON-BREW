{
  "name": "vizioon-brew",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node --env-file=.env node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --env-file=.env node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "postinstall": "node scripts/with-database-url.mjs ./node_modules/.bin/prisma generate",
    "db:migrate": "node scripts/with-database-url.mjs ./node_modules/.bin/prisma migrate dev",
    "db:seed": "node scripts/with-database-url.mjs node --import tsx prisma/seed.ts",
    "db:reset": "node scripts/with-database-url.mjs ./node_modules/.bin/prisma migrate reset --force",
    "runtime:java": "bash -c 'cd src/modules/runtimes/java/15.0.2 && test -x bin/java || bash build.sh'",
    "runtime:python": "bash -c 'cd src/modules/runtimes/python/3.12.0 && test -x bin/python3.12 || { curl -fsSL -o pkg.tar.gz https://github.com/engineer-man/piston/releases/download/pkgs/python-3.12.0.pkg.tar.gz && tar xzf pkg.tar.gz && rm pkg.tar.gz; } && chmod +x run'"
  },
  "prisma": {
    "seed": "node scripts/with-database-url.mjs node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@uiw/react-codemirror": "^4.25.12",
    "animate.css": "^4.1.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "next-auth": "5.0.0-beta.29",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
